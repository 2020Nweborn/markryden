# ===== 2026-11-02 缓存分层（用户批准）=====
# 目的：页面（html）永远实时；图片短期缓存，后台换图最迟 1 天生效；js/css 走长缓存，靠 URL 的 ?v= 换号失效。
# 背景：SiteGround 默认给所有文件发 max-age=15552000（180 天），连 html 和 logo-custom/*.png 都算，
#       导致「页面改了客户看不到」「后台换了 LOGO 客户还看一年前那张」。
# ⛔ 只作用于 logo-customizer/ 这一层，站点根那 25 个产品详情页不受影响。
# ⛔ 全部包在 IfModule 里：服务器没开 mod_headers 时整段自动跳过（等于没加，但绝不会 500）。
#
# ⛔⛔ 2026-11-02 实测结论（非常重要，别以为写了就生效）：
#   SiteGround 是 nginx 前置，**已存在的静态文件（html / json / 图片 / js）由 nginx 直接返回，
#   不经过 Apache，因此本文件的 Header 规则对它们无效**（实测 /index.html 仍是 max-age=15552000）。
#   唯一生效的是「目录请求」：`/logo-customizer/` 走 Apache 的 DirectoryIndex，能拿到 no-cache。
#   → 静态文件的缓存根治 = Cloudflare 的 Response Header Transform Rule，
#     或 SiteGround Site Tools 的缓存面板；前端另有 version.txt 版本哨兵兜底（见 §四 缓存分层）。

<IfModule mod_headers.c>
  # 页面：必须实时。浏览器每次回服务器确认，服务器通常回 304（几百字节），肉眼无感。
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header unset Expires
  </FilesMatch>

  # 配置：前台 fetch 已带 ?t= 时间戳 + no-store，这里再兜一层。
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header unset Expires
  </FilesMatch>

  # 脚本样式：长缓存，改文件时必须同时改引用上的 ?v=（见 §四 缓存分层那条）。
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # 图片：1 天。产品图基本不变，短到 1 天既有新鲜度又不会让首屏每个图都回源确认。
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|avif|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
